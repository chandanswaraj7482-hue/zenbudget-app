{
  "short_name": "ZenBudget",
  "name": "ZenBudget Tracker",
  "icons": [
    {
      "src": "pwa-192x192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any maskable"
    },
    {
      "src": "pwa-512x512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any maskable"
    }
  ],
  "start_url": "/?#app",
  "background_color": "#0d0e12",
  "theme_color": "#10b981",
  "display": "standalone",
  "orientation": "portrait",
  "share_target": {
    "action": "/?shared_receipt=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "receipt",
          "accept": ["image/*", "application/pdf"]
        }
      ]
    }
  }
}
