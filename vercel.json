{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "redirects": [
    { "source": "/zenbudget.apk", "destination": "https://files.catbox.moe/i95g5t.apk", "statusCode": 302 },
    { "source": "/zenbudget-v2.0.3.apk", "destination": "https://files.catbox.moe/i95g5t.apk", "statusCode": 302 },
    { "source": "/zenbudget-latest.apk", "destination": "https://files.catbox.moe/i95g5t.apk", "statusCode": 302 }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/", "destination": "/admin.html" },
    { "source": "/pay", "destination": "/pay.html" },
    { "source": "/pay-success", "destination": "/pay-success.html" },
    { "source": "/((?!.*\\.[\\w]+$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*\\.html|/)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/(.*\\.apk)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" },
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"ZenBudget.apk\"" }
      ]
    },
    {
      "source": "/(.*\\.json)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
