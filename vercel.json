{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "redirects": [
    { "source": "/zenbudget.apk", "destination": "https://zenbudget-tracker.netlify.app/zenbudget.apk", "permanent": false },
    { "source": "/download", "destination": "https://zenbudget-tracker.netlify.app/zenbudget.apk", "permanent": false }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/", "destination": "/admin.html" },
    { "source": "/pay", "destination": "/pay.html" },
    { "source": "/pay-success", "destination": "/pay-success.html" },
    { "source": "/((?!.*\\.[\\w]+$).*)", "destination": "/index.html" }
  ]
}
